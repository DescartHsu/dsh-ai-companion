{
  "name": "dsh-ai-companion",
  "version": "0.1.3",
  "type": "module",
  "description": "Local-first character engine and native DSH Cordis plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DescartHsu/dsh-ai-companion.git"
  },
  "homepage": "https://github.com/DescartHsu/dsh-ai-companion#readme",
  "bugs": {
    "url": "https://github.com/DescartHsu/dsh-ai-companion/issues"
  },
  "main": "./src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./engine": "./src/engine.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-ai-companion": "./src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "config.example.json"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/companion.test.js test/qq-official.test.js test/settings.test.js",
    "check": "node --check src/engine.js && node --check src/server.js && node --check src/plugin.js && node --check src/client.js && node --check src/settings.js",
    "test:package": "node --test test/package.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "1.0.5"
  },
  "devDependencies": {
    "jsdom": "27.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.23.0"
  }
}
